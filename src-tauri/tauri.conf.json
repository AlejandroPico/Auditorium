{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auditorium",
  "version": "0.1.0",
  "identifier": "com.alejandropico.auditorium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auditorium — Modular Audio Studio",
        "width": 1560,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Estudio musical modular",
    "longDescription": "Auditorium reúne composición, interpretación, mezcla, diseño sonoro y actuación DJ en un lienzo modular ampliable.",
    "copyright": "© 2026 Alejandro Pico",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
